{% extends 'base.html.twig' %}

{% block title %}
    Цены периода
{% endblock %}

{% block stylesheets %}
    <style>
        body { font-family: Arial, sans-serif; margin: 24px; background: #f8f9fb; color: #1f2937; }
        .wrap { max-width: 980px; margin: 0 auto; background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px; }
        table { width: 100%; border-collapse: collapse; margin-top: 16px; }
        th, td { border-bottom: 1px solid #e5e7eb; padding: 10px; text-align: left; vertical-align: top; }
        input[type="number"] { width: 100%; box-sizing: border-box; padding: 8px; }
        .actions { display: flex; gap: 8px; margin-top: 16px; }
        .btn { display: inline-block; padding: 10px 14px; text-decoration: none; border-radius: 8px; border: 1px solid #d1d5db; color: #111827; background: #fff; }
        .btn-primary { background: #1d4ed8; color: #fff; border-color: #1d4ed8; }
        .flash { padding: 10px 12px; border-radius: 8px; margin-bottom: 8px; }
        .flash-success { background: #dcfce7; color: #14532d; }
        .flash-danger { background: #fee2e2; color: #7f1d1d; }
        small { opacity: 0.7; }
    </style>
{% endblock %}

{% block body %}
    <div class="wrap">
        <h1 style="margin-top: 0;">Цены периода: {{ period.name }}</h1>
        <p style="margin-bottom: 8px;"><strong>Проект:</strong> {{ period.product.name }}</p>
        <p style="margin-bottom: 16px;"><strong>Период:</strong> {{ period.startAt|date('d.m.Y H:i') }} - {{ period.endAt|date('d.m.Y H:i') }}</p>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash flash-{{ label }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <form method="post" novalidate>
            <input type="hidden" name="_token" value="{{ csrf_token('pricing_period_prices_' ~ period.id) }}">

            <h2 style="margin: 4px 0 12px;">Редактирование периода</h2>
            <div style="display:grid; grid-template-columns: 1fr 220px 220px 150px; gap: 10px; align-items: end;">
                <label>
                    <div style="margin-bottom: 4px;">Название периода</div>
                    <input type="text" name="period_name" value="{{ periodForm.name }}" required style="width:100%; box-sizing:border-box; padding:8px;">
                </label>
                <label>
                    <div style="margin-bottom: 4px;">Начало</div>
                    <input type="datetime-local" name="period_start_at" value="{{ periodForm.startAt }}" required style="width:100%; box-sizing:border-box; padding:8px;">
                </label>
                <label>
                    <div style="margin-bottom: 4px;">Окончание</div>
                    <input type="datetime-local" name="period_end_at" value="{{ periodForm.endAt }}" required style="width:100%; box-sizing:border-box; padding:8px;">
                </label>
                <label style="display:flex; align-items:center; gap:8px; margin-bottom: 8px;">
                    <input type="checkbox" name="period_is_active" value="1" {% if periodForm.isActive %}checked{% endif %}>
                    Активен
                </label>
            </div>

            <h2 style="margin: 18px 0 8px;">Редактирование цен участия</h2>
            <table>
                <thead>
                <tr>
                    <th>Вариант участия</th>
                    <th style="width: 220px;">Цена (₽)</th>
                </tr>
                </thead>
                <tbody>
                {% for option in options %}
                    <tr>
                        <td>
                            <div><strong>{{ option.name }}</strong></div>
                            <small style="opacity:.7;">{{ option.code }}</small>
                        </td>
                        <td>
                            <input
                                type="number"
                                min="0"
                                step="1"
                                name="prices[{{ option.id }}]"
                                value="{{ formPrices[option.id]|default(0) }}"
                                class="form-control"
                                required
                            >
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            <div class="actions">
                <button type="submit" class="btn btn-primary">Сохранить период и цены</button>
                <a href="{{ periodsIndexUrl }}" class="btn">
                    К периодам стоимости
                </a>
            </div>
        </form>
    </div>
{% endblock %}
